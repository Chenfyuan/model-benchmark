# Copy to .env and run ./scripts/dev.sh. .env is git-ignored.
# Local PostgreSQL (docker run ... postgres:16-alpine, published on 5433):
DATABASE_URL=postgresql+psycopg://benchmark:benchmark@127.0.0.1:5433/model_benchmark
# Throwaway database for `pytest` (it is dropped and recreated per test!). Leave unset to test on SQLite.
TEST_DATABASE_URL=postgresql+psycopg://benchmark:benchmark@127.0.0.1:5433/model_benchmark_test
# Port for ./scripts/dev.sh
API_PORT=8010
